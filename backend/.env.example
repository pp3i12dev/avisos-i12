# Debe guardarse como backend/.env, NO en web-admin ni en la raíz.
# Nunca subir el .env real a GitHub.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require
JWT_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES
# Web Push se administra desde «Configuración» y se guarda en PostgreSQL.
# No hace falta introducir correo de VAPID ni mantener WEB_PUSH_SUBJECT.
# SOLO PARA HOSTING ANTIGUO con claves gestionadas exclusivamente en .env:
# WEB_PUSH_ENABLED=true
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:contacto@institucion.edu.ar
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://mi-otro-preview.pages.dev

# ETAPA 30: SMTP/VAPID cifrados con una clave DERIVADA de JWT_SECRET.
# JWT_SECRET debe ser aleatorio, estable y tener al menos 32 caracteres.
# Nunca introducir JWT_SECRET en la app ni enviarlo al navegador.
# Para secretos guardados antes de Etapa 30 con v1: conservar temporalmente
# la clave antigua y volver a guardar contraseñas/keys desde Configuración.
# APP_CONFIG_ENCRYPTION_KEY=CLAVE_ANTIGUA_SOLO_SI_HAY_SECRETOS_V1
# Las credenciales nuevas usan v2 y NO requieren APP_CONFIG_ENCRYPTION_KEY.
